# sqlite (default, no cloud) or d1 (Cloudflare Worker + D1)
SONGBOOK_DB=sqlite

# Worker URL used when SONGBOOK_DB=d1. The dev server proxies /api there.
# The browser never receives D1 credentials.
SONGBOOK_D1_URL=

# Production build for GitHub Pages. Leave empty for local sqlite.
# Example: https://songbook.<account>.workers.dev
VITE_SONGBOOK_API=

# Spotify Web API client id (Authorization Code + PKCE). Public; no client secret.
# Create an app at https://developer.spotify.com/dashboard and add redirect URIs:
#   http://127.0.0.1:4322/spotify/callback
#   https://jorsanchezch.github.io/songs/spotify/callback
# Leave empty to hide “Crear playlist en Spotify” on setlists.
VITE_SPOTIFY_CLIENT_ID=

# YouTube Data API v3 (free). Used by media backfill for search + duration/BPM.
# On the Worker: npx wrangler secret put YOUTUBE_API_KEY
YOUTUBE_API_KEY=

# Optional: mark R2 as configured for local CLI dry-runs of media backfill.
# Real local MP3s go to data/audio via the Vite API (never into SQLite/D1 rows).
SONGBOOK_AUDIO_BUCKET=
SONGBOOK_AUDIO_DIR=
