# sqlite (default, no cloud) or d1 (Cloudflare Worker + D1)
SONGBOOK_DB=sqlite

# Worker URL used when SONGBOOK_DB=d1. The dev server proxies /api there.
# The browser never receives D1 credentials.
SONGBOOK_D1_URL=

# Production build for GitHub Pages. Leave empty for local sqlite.
# Example: https://songbook.<account>.workers.dev
VITE_SONGBOOK_API=
