{title: Agnus Dei}
{artist: En Espiritu Y En Verdad}
{composer: Michael W. Smith}
{key: A}
{source: https://acordes.lacuerda.net/en_espiritu_y_en_verdad/agnus_dei.shtml}

{start_of_verse}
[A]        [D]
Aleluya, Aleluya
                           [A]
Nuestro Dios, Poderoso es Rey
           [D]
Aleluya, Aleluya
                           [A]
Nuestro Dios, Poderoso es Rey
    [D]
Ale-lu-u-ya
{end_of_verse}

{start_of_chorus}
[D]  [E][A]
Sa - anto, Santo,
                       [E]
Eres tu Dios Poderoso Rey
           [D]
Digno eres Tú, Cordero de Dios
         [A]
Tú eres Santo
{end_of_chorus}
