{title: Danzo En El Río}
{artist: Miel San Marcos}
{composer: Josh Morales y Luis Morales Jr.}
{key: D}
{source: https://www.cifraclub.com/miel-san-marcos/danzo-en-el-rio/}

{start_of_intro}
[Bm7]   [G]   [D]   [A]
{end_of_intro}

{start_of_verse: Primera Parte}
[G]
Un estruendo de muchas aguas
     [Bm7]         [A]
Se escucha aquí
[G]
Trae sanidad, trae libertad
[G]
Gozo y salvacion
[G]
Es el rio del Señor
     [Bm7]         [A]
Que nace de su corazón
 [G]
Nunca se secará
   [Bm7]      [A]
Y esta ciudad se alegrará
{end_of_verse}

{start_of_chorus: Coro}
 [D]
Yo danzo en el río
 [A]
Yo danzo en el río
      [Em7]   [Bm7]
En el río de Dios
      [G]
En el río de Dios
{end_of_chorus}

{start_of_bridge: Puente}
     [Bm7]  [G]     [D]     [A]
Hay vida en el río de Dios
     [Bm7]  [G]     [D]     [A]
Hay gozo en el río de Dios
      [Bm7]    [G]
Soy libre, libre
    [D]      [A]        [Bm7]
El río de Dios está aquí
{end_of_bridge}
