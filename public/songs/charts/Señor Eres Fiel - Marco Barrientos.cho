{title: Señor Eres Fiel}
{artist: Marco Barrientos}
{composer: Israel Houghton}
{key: C}
{source: https://www.cifraclub.com/marco-barrientos/seor-eres-fiel/?keyShape=3}
{source: https://www.youtube.com/watch?v=pkfmBLEVvNg | YouTube}
{bpm: 129}
{duration_ms: 356000}

{start_of_intro}
[G] [D/G] [F/G] [C/G]  [G] [D/G] [F/G] [C/G]
{comment: Repeat (//)}
{end_of_intro}

{start_of_verse}
    [G]                [D/G]        [F/G]     [C/G]
//señor eres fiel y tu misericordia eterna//
{end_of_verse}

{start_of_chorus}
[C]            [D/C]
Gente de toda lengua y nacion
   [D#/C]         [F][F][F][F]
De generacion a generacion
       [G]   [D] [F]      [C]
Te adoramos hoy, aleluya, aleluya
       [G]   [D]           [F]   [C]
Te adoramos hoy, eres Señor
       [G]   [D] [F]      [C]
Te adoramos hoy, aleluya, aleluya
       [G/B][Dm7]       [D#] [FDD]
Te adoramos hoy, eres Señor
{end_of_chorus}

{start_of_solo}
          [G]   [D/G][F/G][C/G]
Tu eres fiel
{comment: Solo}
{end_of_solo}

{start_of_verse: English}
    [G]                      [D/G]            [F/G]    [C/G]
//Lord you are good and your mercy endureth forever//
{end_of_verse}

{start_of_chorus: English}
  [C]              [D/C]
People from every nation and tongue
[D#/C]               [F][F][F][F]
From generation to generation
      [G]    [D][F]       [C]
We worship you, aleluya, aleluya
      [G]    [D]              [F]   [C]
We worship you, for who you are
      [G]    [D] [F]      [C]
We worship you, aleluya, aleluya
     [G/A#]   [Dm7]           [D#]  [FDD]
We worship you for who you are
{end_of_chorus}

{start_of_bridge}
            [G][G][A#][A#][C]  [G][G][F][F][C/E]
You are good
{comment: Repeat chord progression (//)}
             [G][G]   [A#][A#] [C]
////You are good, all the time
          [G][G] [F] [F] [C/E]
All the time, all the time you are good////
{end_of_bridge}

{start_of_verse}
       [G]               [D/G]         [F/G]          [C/G]
////Señor eres fiel y tu misericordia eterna////
