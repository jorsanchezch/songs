{title: Tu Eres Mi Respirar}
{artist: Ingrid Rosario}
{composer: Marie Barnett}
{key: G}
{source: https://www.cifraclub.com/ingrid-rosario/tu-eres-mi-respirar/}

{start_of_verse}
 [G]        [C]
Tu eres mi respirar
 [G]        [C]
Tu eres mi respirar

[G]  [D][Em]    [D]
Dios tu presencia
[C]  [Em][D]
Vive en mi
{end_of_verse}

{start_of_verse}
 [G]            [C]
Tu eres mi pan señor
 [G]            [C]
Tu eres mi pan señor

[G]  [D] [Em]   [D]
Dios tus palabras
[C]    [Em][D]
Fluyen en mi
{end_of_verse}

{start_of_chorus}
  [G] [D] [Em] [D]      [C]    [Em] [D]
Y yooooo     te anhelo, señor
  [G] [D] [Em] [D]    [C]      [Em] [D]
Estoyooo     perdido sin ti
{end_of_chorus}
