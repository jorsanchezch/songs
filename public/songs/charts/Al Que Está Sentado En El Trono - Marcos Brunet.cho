{title: Al Que Está Sentado En El Trono}
{artist: Marcos Brunet}
{composer: Lucas Conslie}
{key: B}
{source: https://www.cifraclub.com/marcos-brunet/al-que-esta-sentado-en-el-trono/}

{start_of_intro}
[E9]   [G#m]   [B]
[E9]   [G#m]   [B]   [F#]
[E9]   [G#m]   [B]
[E9]   [G#m]   [B/D#]   [F#]   [F#4]
[E9]   [F#]   [E9]   [F#]
{end_of_intro}

{start_of_verse: Primera Parte}
   [B2]
Quiero conocerte
 [G#m]
Cada día más a ti
    [F#]                       [E]
Entrar en tu presencia y adorar
[E11+]  [E]
   [G#m]
Revélanos tu gloria
    [F#]
Deseamos ir mucho más en ti
    [E]
Queremos tu presencia
   [F#4]  [F#]
Jesús
{end_of_verse}

{start_of_chorus: Coro}
[B2]
Al que está sentado en el trono
[G#m]
Al que vive para siempre y siempre
         [C#m]           [B/D#]
Sea la gloria, sea la honra y el poder
         [E]             [F#]     [F#4]
Sea la gloria, sea la honra y el poder
[B2]
Al que está sentado en el trono
[G#m]
Al que vive para siempre y siempre
         [C#m]           [B/D#]
Sea la gloria, sea la honra y el poder
         [E]    [E11+]
Sea la gloria
        [F#]           [F#4]
Sea la honra y el poder
{end_of_chorus}

