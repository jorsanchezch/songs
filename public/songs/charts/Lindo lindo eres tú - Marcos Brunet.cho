{title: Lindo lindo eres tú}
{artist: Marcos Brunet}
{composer: Juliano Son}
{key: Am}
{source: https://www.cifraclub.com/marcos-brunet/lindo-lindo-eres-tu/}

{start_of_intro}
[Am7]   [F9]   [C]   [G]
{end_of_intro}

{start_of_chorus}
   [Am7]                    [F9]
Lindo, lindo, eres tu
                  [C]       [G]
Gloria, gloria yo te doy, Jesús, Jesús
     [Am7]                [F9]
Me llevas delante del trono
              [C]
Muestra tu belleza
               [Em7]
Quiero ver tu rostro
{comment: Repeat block above (////)}
{end_of_chorus}

{start_of_bridge}
            [Am7]  [F9]
Queremos conocerte mas
                   [C]
Queremos conocerte mas
                   [Em]
Queremos conocerte mas
{comment: Repeat block above (//)}
{end_of_bridge}

{start_of_chorus}
     [Am7]                [F9]
Me llevas delante del trono
              [C]
Muestra tu belleza
               [Em7]
Quiero ver tu rostro
{comment: Repeat block above (////)}
{end_of_chorus}

{start_of_bridge}
            [Am7]  [F9]
Queremos conocerte mas
                   [C]
Queremos conocerte mas
                   [Em]
Queremos conocerte mas
{comment: Repeat block above (//)}
{end_of_bridge}

{start_of_outro}
[Am7]   [F9]   [C]   [G]
{end_of_outro}
