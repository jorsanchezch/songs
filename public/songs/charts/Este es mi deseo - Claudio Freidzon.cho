{title: Este es mi deseo}
{artist: Claudio Freidzon}
{composer: Reuben Morgan}
{key: G}
{source: https://www.cifraclub.com/claudio-freidzon/este-es-mi-deseo/}

{start_of_intro}
[C]   [D]   [Bm]   [Em]
{end_of_intro}

{start_of_verse}
[G]                [Em]
Este es mi deseo
[Am]       [G]     [D]
Honrarte a Ti
[Em]               [G]
Con todo mi ser
[F]        [C]     [D]
Te adoro a Ti
[G]                [Em]
Con todas mis fuerzas
[Am]       [G]     [D]
Te alabaré
[Em]       [G]     [F]     [C]     [D]
Mi adoración eres Tú
{end_of_verse}

{start_of_chorus}
[G]                [D/F#]
Hoy te rindo mi ser
[Am]
Te doy mi corazón
[C]        [D]     [G]
Yo vivo para Ti
[D/F#]
En cada palpitar
[Am]
Mientras haya aliento en mí
[C]        [D]     [G]
Dios haz tu obra en mí
{end_of_chorus}
