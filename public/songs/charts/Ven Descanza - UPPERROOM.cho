{title: Ven Descanza}
{artist: UPPERROOM}
{composer: Upperrom}
{key: C}
{source: https://www.cifraclub.com/upper-room-music/ven-descanza/}

{start_of_intro}
[C]   [F]
{end_of_intro}

{start_of_verse: Primera Parte}
[C]   [C4]
Así
[C]
Como lo hiciste
[C]
Sobre las aguas
[F]
Muévete hoy aquí
[Am]
Ven descansa
[F]
En Nosotros
{comment: Repeat primera parte 2x}
{end_of_verse}

{start_of_chorus: Coro}
[C]
Vienes y haces que mi
[C/E]  [F]
Corazón se alegre
                     [G]
Cuando llenas el lugar
[Am]                         [C/E]
Tú estás y te estás moviendo
[F]
Yo estoy y me estoy llenando
{comment: Repeat coro 2x}
{end_of_chorus}

{start_of_verse: Segunda Parte}
[C]
Con fuego y viento
[C]
Ven hazlo otra vez
[F]
Abre los cielos Y muévete aquí
[Am]
Ven descansa
[F]
En nosotros
{comment: Repeat segunda parte 2x}
{end_of_verse}

{start_of_chorus}
[C]
Vienes y haces que mi
[C/E]  [F]
Corazón se alegre
                     [G]
Cuando llenas el lugar
[Am]                         [C/E]
Tú estás y te estás moviendo
[F]
Yo estoy y me estoy llenando
{comment: Repeat coro 2x}
{end_of_chorus}

{start_of_bridge: Puente}
[C/G]         [Dm]
Santo Espíritu desciende
[Am]
Te anhelo a Ti
[F]
Te anhelo a Ti
{comment: Repeat puente 4x}
{end_of_bridge}

{start_of_chorus}
[C]
Vienes y haces que mi
[C/E]  [F]
Corazón se alegre
                     [G]
Cuando llenas el lugar
[Am]                         [C/E]
Tú estás y te estás moviendo
[F]
Yo estoy y me estoy llenando
{comment: Repeat coro 2x}
{end_of_chorus}

{start_of_bridge}
[C/G]         [Dm]
Santo Espíritu desciende
[Am]
Te anhelo a Ti
[F]
Te anhelo a Ti
{end_of_bridge}

{start_of_outro: Parte Final}
 [C/G]  [Dm]  [Am]  [F]
{end_of_outro}
