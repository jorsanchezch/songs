{title: Hermoso Nombre}
{artist: Hillsong en Español}
{composer: Brooke Ligertwood y Ben Fielding}
{key: D}
{source: https://www.cifraclub.com/hillsong-en-espaol/hermoso-nombre/}

{start_of_verse: Primera Parte}
                              [D]
Tú fuiste el verbo en el principio
[D]
Unigénito de Dios
[D]
El misterio de tu gloria
[D]
Revelado en tu amor
{end_of_verse}

{start_of_chorus: Estribillo}
                       [D]
Cuán hermoso su nombre es
                       [A]
Cuán hermoso su nombre es
           [Bm]   [A]       [G]
El nombre de Jesús, mi Rey
                       [D/F#]
Cuán hermoso su nombre es
                 [A]
Nada se iguala a Él
                       [Bm]
Cuán hermoso su nombre es
       [A]     [G]
No hay otro nombre
{end_of_chorus}

{start_of_verse: Segunda Parte}
[D]
  Dejaste el cielo por salvarme
      [G]       [Bm]   [A]
Me viniste a rescatar
[Bm]                     [A/C#]  [D]
   Mi transgresión tú perdo_naste
      [G]     [Bm]  [A]
Nada nos separará
{end_of_verse}

{start_of_chorus}
                     [D]
Majestuoso su nombre es
                     [A]
Majestuoso su nombre es
           [Bm]   [A]       [G]
El nombre de Jesús, mi Rey
                     [D/F#]
Majestuoso su nombre es
                 [A]
Nada se iguala a Él
                     [Bm]
Majestuoso su nombre es
       [A]     [G]
No hay otro nombre
                     [Bm]
Majestuoso su nombre es
       [A]     [G]
No hay otro nombre
{end_of_chorus}

{start_of_interlude}
[G]   [A]   [Bm]   [F#m]
[G]   [A]   [Bm]   [F#m]
[G]   [A]   [Bm]   [F#m]
{end_of_interlude}

{start_of_bridge: Ponte 1}
              [G]
La muerte venciste
            [A]
El velo partiste
            [Bm]          [D/F#]
La tumba vacía ahora está
               [G]
Los cielos declaran
               [A]
Tu gloria proclaman
       [Bm]            [A]
Resucitaste en majestad
       [G]
Inigualable
        [A]
Incomparable
            [Bm]          [D/F#]
Hoy y por siempre reinarás
            [G]
Tuyo es el reino
             [A]
Tuya es la gloria
           [Bm]          [A]
Tuyo el poder y autoridad
{end_of_bridge}

{start_of_chorus}
                   [D]
Poderoso su nombre es
                   [A]
Poderoso su nombre es
           [Bm]   [A]       [G]
El nombre de Jesús, mi Rey
                   [D/F#]
Poderoso su nombre es
                [A]
Incomparable es Él
                   [Bm]
Poderoso su nombre es
       [A]     [G]
No hay otro nombre
{end_of_chorus}

{start_of_bridge: Ponte 2}
       [G]
Inigualable
        [A]
Incomparable
            [Bm]          [D/F#]
Hoy y por siempre reinarás
            [G]
Tuyo es el reino
             [A]
Tuya es la gloria
           [Bm]          [A]
Tuyo el poder y autoridad
{end_of_bridge}

