{title: Nuestro Dios}
{artist: Chris Tomlin}
{composer: Chris Tomlin}
{key: A}
{source: https://www.cifraclub.com/chris-tomlin/nuestro-dios/}
{source: https://www.youtube.com/watch?v=K_pOtsVAo_Q | YouTube}
{bpm: 105}
{duration_ms: 283000}

{start_of_intro}
[F#m]   [D]   [A/C#]   [E]
{end_of_intro}

{start_of_verse: Primera Parte}
[F#m]       [D]        [A]
De la cruz nos rescató
   [F#m]       [D]       [A]
Nuestra libertad el compró
              [Bm]
No hay nadie como Tú
        [E]
No lo hay
{end_of_verse}

{start_of_verse: Segunda Parte}
[F#m]         [D]       [A]
Brillas en la oscuridad
    [F#m]     [D]      [A]
Por siempre permanecerás
              [Bm]
No hay nadie como Tú
       [E]
No lo hay
{end_of_verse}

{start_of_chorus: Coro}
[F#m]
Mi Dios es grande
[D]
Mi Dios es fuerte
[A]                       [E]
Él es más alto que cualquier otro
[F#m]
Nuestro Dios sana
[D]
Es poderoso
[A]                 [E]
Mi Dios, nuestro Dios
{end_of_chorus}

{start_of_bridge: Puente}
[F#m]
Si Dios es por nosotros
[D]
Quien contra nosotros
[A]
Si Dios es está conmigo
[E]
¿Quién nos podrá parar?
{end_of_bridge}
